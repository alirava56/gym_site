# Required in production. Use a unique random value of at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret

# Admin credentials. Keep these server-side only.
ADMIN_USERNAME=admin
# Production: generate this with `npm run hash-password -- "your strong password"`
ADMIN_PASSWORD_HASH=salt:128-hex-character-scrypt-hash
# Local development fallback only; ignored in production when no hash is present.
ADMIN_PASSWORD=replace-with-a-local-dev-password

# Required PostgreSQL connection. Never expose this as NEXT_PUBLIC_*.
DATABASE_URL=postgresql://gym_app:replace-me@127.0.0.1:5432/gym
# Set to require when the provider requires verified TLS.
DATABASE_SSL=disable
# Trust forwarding headers only behind an enforcing reverse proxy such as Nginx.
TRUST_PROXY=false

# Optional app metadata
NEXT_PUBLIC_APP_NAME=باشگاه شب قهرمانان
